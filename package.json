{
  "name": "unimcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server NO OFICIAL para universidades argentinas: aula virtual (Moodle) y SIU Guaraní.",
  "main": "build/index.js",
  "bin": {
    "unimcp": "build/index.js"
  },
  "files": [
    "build",
    "vendor"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "node scripts/vendor-pdfjs.mjs",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "login": "tsx src/index.ts login"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "aula-virtual",
    "siu-guarani",
    "universidad",
    "argentina",
    "unju",
    "unsa",
    "unt",
    "uba"
  ],
  "author": "MaxiFG",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@napi-rs/keyring": "^2.1.0",
    "express": "^5.2.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
