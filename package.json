{
  "name": "unimcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server NO OFICIAL para universidades argentinas: aula virtual (Moodle) y SIU Guaraní.",
  "main": "build/index.js",
  "bin": {
    "unimcp": "build/index.js"
  },
  "files": [
    "build",
    "vendor"
  ],
  "scripts": {
    "vendor": "node scripts/vendor-pdfjs.mjs",
    "prebuild": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && npm run vendor",
    "build": "tsc",
    "prepack": "npm run build",
    "mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "start": "node build/index.js",
    "predev": "npm run vendor",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "login": "tsx src/index.ts login"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "aula-virtual",
    "siu-guarani",
    "universidad",
    "argentina",
    "siu",
    "unju",
    "unsa",
    "unt",
    "uba"
  ],
  "author": "MaxiFG",
  "homepage": "https://github.com/HyNuwa/UniMCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyNuwa/UniMCP.git"
  },
  "bugs": {
    "url": "https://github.com/HyNuwa/UniMCP/issues"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@napi-rs/keyring": "^2.1.2",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
