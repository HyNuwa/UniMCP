---
import { INSTALL } from "../data/copy";
import { PKG, REPO } from "../data/site";

const tabs = INSTALL.map((t) => ({ ...t, code: t.code.replaceAll("{pkg}", PKG), note: t.note.replaceAll("{pkg}", PKG) }));
---

<section id="instalar" style="padding: 140px 16px 0">
    <div class="install">
        <div style="flex: 1 1 320px; min-width: 0">
            <h2 class="disp h2" style="margin-bottom: 20px">Instalalo en dos minutos</h2>
            <p style="margin: 0 0 28px; font-size: 17px; line-height: 1.55; color: var(--on-dark)">
                Con Claude Desktop no hace falta la terminal: bajás la extensión y le hacés doble click. Para los demás clientes necesitás Node 22.
            </p>
            <ol class="steps">
                <li><span class="mono">01</span><span>Iniciás sesión una vez: elegís tu campus y entrás con tu usuario del aula y de Guaraní.</span></li>
                <li><span class="mono">02</span><span>Lo agregás a tu cliente. Las sesiones se renuevan solas.</span></li>
                <li><span class="mono">03</span><span>Le preguntás lo que necesites.</span></li>
            </ol>
            <a class="pill pill-white" href={`${REPO}/releases/latest`} style="margin-top: 28px">Bajar la extensión ↗</a>
        </div>
        <div style="flex: 1.3 1 440px; min-width: 0" data-tabs>
            <div role="tablist" aria-label="Cliente" style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px">
                {
                    tabs.map((t, i) => (
                        <button class="tab" role="tab" type="button" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                            {t.label}
                        </button>
                    ))
                }
            </div>
            {
                tabs.map((t, i) => (
                    <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
                        <div class="code">
                            <div class="code-bar">
                                <span class="mono" style="font-size: 12px; color: rgba(255,255,255,.62)">{t.file}</span>
                                <button class="tab is-on" type="button" data-copy style="padding: 8px 14px; min-height: 36px; font-size: 13px">Copiar</button>
                            </div>
                            <pre class="mono"><code>{t.code}</code></pre>
                        </div>
                        <p style="margin: 16px 0 0; font-size: 14px; line-height: 1.5; color: rgba(255,255,255,.62)">{t.note}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .install { max-width: 1240px; margin: 0 auto; background: var(--dark); color: var(--white); border-radius: 36px; padding: clamp(28px, 5vw, 72px); display: flex; flex-wrap: wrap; gap: 48px; }
    .steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 15px; line-height: 1.5; }
    .steps li { display: flex; gap: 14px; }
    .steps .mono { color: var(--coral); }
    .code { background: #1c1b1a; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 22px; overflow: hidden; }
    .code-bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px 12px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
    pre { margin: 0; padding: 22px 20px; font-size: 14px; line-height: 1.7; white-space: pre-wrap; word-break: break-word; color: var(--soft); }
</style>

<script>
    for (const box of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
        const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const show = (tab: HTMLButtonElement) => {
            for (const t of tabs) {
                const on = t === tab;
                t.setAttribute("aria-selected", String(on));
                t.tabIndex = on ? 0 : -1;
                box.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
            }
        };
        for (const [i, tab] of tabs.entries()) {
            tab.addEventListener("click", () => show(tab));
            // Flechas entre pestañas, como pide el patrón de tabs de ARIA.
            tab.addEventListener("keydown", (e) => {
                const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
                if (!step) return;
                const next = tabs[(i + step + tabs.length) % tabs.length];
                show(next);
                next.focus();
            });
        }
        for (const button of box.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
            button.addEventListener("click", async () => {
                const code = button.closest('[role="tabpanel"]')!.querySelector("code")!.textContent ?? "";
                try {
                    await navigator.clipboard.writeText(code);
                    button.textContent = "Copiado";
                } catch {
                    button.textContent = "No se pudo copiar";
                }
                setTimeout(() => (button.textContent = "Copiar"), 1600);
            });
        }
    }
</script>
