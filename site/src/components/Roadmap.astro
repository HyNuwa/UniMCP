---
import { HORIZONS } from "../data/copy";
import { REPO, STATS } from "../data/site";
---

<section class="wrap section">
    <p class="eyebrow">06 / Roadmap</p>
    <div class="split" style="margin-bottom: 40px">
        <h2 class="disp h2">Lo que viene</h2>
        <div style="display: flex; flex-direction: column; gap: 14px; align-items: flex-start">
            <p class="lead">Hoy estamos en que lo puedas usar sin instalar nada. Lo que está a la derecha todavía no tiene fecha.</p>
            <a class="mono" href={`${REPO}/blob/master/docs/roadmap.md`} style="font-size: 13px">Roadmap técnico ↗</a>
        </div>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 40px 16px">
        {
            HORIZONS.map((h) => (
                <div class={`horizon ${h.tone}`} style={`flex: ${h.wide ? "2 1 460px" : "1 1 230px"}`}>
                    <div class="bar" aria-hidden="true" />
                    <div style="display: flex; align-items: center; gap: 10px; min-height: 30px">
                        <span class="dot h-dot" />
                        <span style="font-weight: 600; font-size: 15px">{h.label}</span>
                        {h.tone === "now" && <span class="tag" style="background: var(--ink); color: var(--white)">estás acá</span>}
                    </div>
                    <ol>
                        {h.items.map((r) => (
                            <li>
                                <h3 class="disp">{r.title}</h3>
                                <p class="text">{r.text}</p>
                                <p class="mono tech">{r.tech.replace("{tools}", String(STATS.tools))}</p>
                            </li>
                        ))}
                    </ol>
                </div>
            ))
        }
    </div>
</section>

<style>
    .horizon { min-width: 0; display: flex; flex-direction: column; gap: 16px; }
    .bar { position: relative; height: 10px; border-radius: 5px; }
    ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; flex: 1; }
    li { border-radius: 24px; padding: 22px; display: flex; flex-direction: column; gap: 10px; background: var(--white); }
    h3 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
    .text { margin: 0; font-size: 15px; line-height: 1.5; color: var(--muted); flex: 1; }
    .tech { margin: 6px 0 0; padding-top: 12px; border-top: 1px dashed #dedcd6; font-size: 12px; line-height: 1.5; color: var(--muted); }

    .done .bar, .done .h-dot { background: var(--ink); }
    .done li { background: var(--ink); color: var(--white); }
    .done .text, .done .tech { color: var(--on-dark); }
    .done .tech { border-color: rgba(255, 255, 255, 0.25); }

    .now .bar, .now .h-dot { background: var(--coral); }
    .now .bar { background-image: repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.38) 0 7px, transparent 7px 14px); background-size: 28px 10px; animation: stripes 1.2s linear infinite; }
    .now li { background: var(--coral); }
    .now .text, .now .tech { color: #2a1a14; }
    .now .tech { border-color: rgba(11, 11, 12, 0.3); }

    .next .bar, .next .h-dot { background: var(--aula); }

    .later .bar { border: 2px dashed #b9b5ac; }
    .later .h-dot { border: 2px solid #8a867e; }
    .later li { background: transparent; border: 2px dashed #cfcbc3; }
    .later .tech { border-color: #cfcbc3; }

    @keyframes stripes { to { background-position: 28px 0; } }
    @media (prefers-reduced-motion: reduce) { .now .bar { animation: none; } }
</style>
