---
import { REPO, UNIVERSITIES } from "../data/site";
import { TESTED_BY } from "../data/places";

type Person = { login: string; avatar: string };

/** Quienes aportaron, de la API de GitHub en el build. Sin red (o sin cuota), los que probaron una universidad. */
async function contributors(): Promise<Person[]> {
    const fallback = [...new Set(Object.values(TESTED_BY))].map((login) => ({ login, avatar: `https://github.com/${login}.png?size=128` }));
    try {
        const headers: Record<string, string> = { accept: "application/vnd.github+json" };
        if (process.env.GITHUB_TOKEN) headers.authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
        const res = await fetch("https://api.github.com/repos/HyNuwa/UniMCP/contributors?per_page=100", { headers });
        if (!res.ok) return fallback;
        const list = (await res.json()) as { login: string; type: string; avatar_url: string }[];
        const people = list.filter((c) => c.type === "User").map((c) => ({ login: c.login, avatar: `${c.avatar_url}&s=128` }));
        return people.length ? people : fallback;
    } catch {
        return fallback;
    }
}

const people = await contributors();
const codes = UNIVERSITIES.map((u) => u.id);

// Esfera de mosaicos: filas de latitud con su cantidad de mosaicos. Las personas se reparten a lo largo
// (al menos 3 lugares, repitiendo si son menos, para que siempre haya una cara a la vista); los demás quedan libres.
const rows: [number, number][] = [[-48, 8], [-24, 11], [0, 13], [24, 11], [48, 8]];
const total = rows.reduce((s, r) => s + r[1], 0);
const faces = Math.max(people.length, 3);
const every = Math.max(1, Math.floor(total / faces));
let k = 0;
let placed = 0;
const tiles = rows.flatMap(([lat, n], ri) =>
    Array.from({ length: n }, (_, i) => {
        const style = `transform: rotateY(${(i * 360) / n + ri * 14}deg) rotateX(${-lat}deg) translateZ(196px)`;
        const index = k++;
        if (index % every === 0 && placed < faces) return { style, person: people[placed++ % people.length] };
        if (index % 4 === 1) return { style, text: "+", kind: "plus" };
        if (index % 4 === 3) return { style, text: codes[(index >> 2) % codes.length], kind: "code" };
        return { style, text: "?", kind: "empty" };
    }),
);
const count = people.length;
---

<section id="comunidad" class="wrap section">
    <div style="display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
        <div style="flex: 1 1 380px; min-width: 0">
            <p class="eyebrow">05 / Comunidad</p>
            <h2 class="disp h2" style="margin-bottom: 16px">
                {count === 1 ? <>Hoy somos uno.<br />La esfera tiene lugar.</> : <>Hoy somos {count}.<br />La esfera tiene lugar.</>}
            </h2>
            <p class="lead" style="margin-bottom: 28px; max-width: 480px">Cada persona que aporta suma su avatar de GitHub: con un PR, probando su facultad o contando qué le falta.</p>
            <div style="display: flex; flex-wrap: wrap; gap: 10px">
                <a class="pill pill-ink" href={`${REPO}/blob/master/CONTRIBUTING.md`}>Cómo colaborar ↗</a>
                <a class="pill pill-white" href={`${REPO}/graphs/contributors`}>Ver colaboradores</a>
            </div>
        </div>
        <div style="flex: 1 1 440px; min-width: 0; overflow: hidden; padding: 24px 0">
            <div class="globe-stage" role="img" aria-label={`Esfera giratoria con ${count === 1 ? "el avatar de quien colabora" : `los avatares de las ${count} personas que colaboran`} y lugares libres`}>
                <div class="globe">
                    {
                        tiles.map((t) => (
                            <div class={`tile ${t.kind ?? ""}`} style={t.style}>
                                {t.person ? <img src={t.person.avatar} alt="" width="64" height="64" loading="lazy" /> : <span class="disp">{t.text}</span>}
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .globe-stage { perspective: 1300px; width: 440px; height: 440px; position: relative; margin: 0 auto; }
    .globe { position: absolute; inset: 0; transform-style: preserve-3d; animation: spin 48s linear infinite; }
    .globe-stage:hover .globe { animation-play-state: paused; }
    @keyframes spin { from { transform: rotateX(-12deg) rotateY(0deg); } to { transform: rotateX(-12deg) rotateY(360deg); } }
    .tile { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 16px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #e9e6df; }
    .tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tile.plus { background: var(--coral); font-size: 28px; }
    .tile.code { background: var(--white); font-size: 14px; }
    .tile.empty { color: #8a867e; font-size: 22px; }
    @media (prefers-reduced-motion: reduce) { .globe { animation: none; transform: rotateX(-12deg) rotateY(20deg); } }
    @media (max-width: 620px) { .globe-stage { transform: scale(0.68); margin: -70px auto; } }
</style>
